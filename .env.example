# Copy this file to `.env` and fill in your credentials.
#
# LLMEval-Logic talks to a single OpenAI-compatible Chat Completions
# endpoint. Any provider that accepts
#   POST {OPENAI_BASE_URL}/chat/completions
# with `Authorization: Bearer ${OPENAI_API_KEY}` works out of the box:
# OpenAI, OpenRouter, DeepInfra, Fireworks, an in-house vLLM/SGLang
# proxy, Ollama in OpenAI-compat mode, ...

OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
