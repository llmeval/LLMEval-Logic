# Credentials
.env

# Held-out / non-public assets (NEVER push)
# - bench_full/      : backup of the un-split corpus (kept locally only)
# - bench_private/   : 20% private contamination-resistant holdout
# - acl_latex.pdf    : paper draft; will be released on arXiv separately
# - *.zip / *.tar.*  : guard against auto-archives (e.g. iCloud) of the above
bench_full/
bench_private/
bench_private*
bench_full*
acl_latex.pdf

# Local-only maintenance scripts (one-off restructure utilities, etc.)
tools/
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tar.xz

# Run outputs (regenerated by users)
# Top-level only so we don't accidentally exclude `code/fl_eval/formalize/` etc.
/output/
/result/
/formalize/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
