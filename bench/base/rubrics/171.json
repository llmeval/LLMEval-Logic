    {
      "id": "SC2",
      "group": "stated_constraint",
      "desc": "形式化必须表示每个密码位置至多只能对应一个数字，不能同一位置同时是两个不同数字。",
      "score": 0,
      "reason": "这是三位密码中每一位唯一取值的必要约束，否则线索中的“号码正确”无法按单个数字位解释。",
      "z3_check": {
        "atoms": [
          {
            "key": "P",
            "nl": "位置 x 是数字 y"
          },
          {
            "key": "x",
            "nl": "任一位置"
          },
          {
            "key": "z",
            "nl": "任一数字"
          },
          {
            "key": "u",
            "nl": "另一任一数字"
          }
        ],
        "formula": "forall x. forall z. forall u. ((z != u) -> (P(x,z) -> ~P(x,u)))",
        "mode": "entails"
      }
    },
    {
      "id": "SC3",
      "group": "stated_constraint",
      "desc": "形式化必须表示三位密码的数字互不相同，即同一个数字不能出现在两个不同位置。",
      "score": 0,
      "reason": "题干明确要求三位数字不同，此约束直接影响哪些密码候选可被接受。",
      "z3_check": {
        "atoms": [
