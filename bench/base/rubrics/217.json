    {
      "id": "LR4",
      "group": "logical_relation",
      "desc": "候选形式化必须表达：主节点不可能同时既受损又激活，即排除主节点受损与主节点激活的合取。",
      "score": 0,
      "reason": "该互斥约束限制主节点两种属性不能并存，是判断从节点激活可能性的关键约束之一。",
      "z3_check": {
        "atoms": [
