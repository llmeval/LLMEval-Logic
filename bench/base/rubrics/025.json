        "atoms": [
          {
            "key": "F",
            "nl": "选物理"
          },
          {
            "key": "B",
            "nl": "选化学"
          }
        ],
        "formula": "(F -> B) & (B -> F)",
        "mode": "entails"
      }
    },
    {
      "id": "LR2",
      "group": "logical_relation",
      "desc": "应表示生物和地理不能同时选择。",
