        "formula": "forall x. (FG(x) <-> (H(x) | FF(x)))",
        "mode": "entails"
      }
    },
    {
      "id": "LR2",
      "group": "logical_relation",
      "desc": "形式化应表达：内史与外史身份互斥，任何人若是内史则不是外史。",
