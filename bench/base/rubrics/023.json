            "nl": "L1灯亮"
          },
          {
            "key": "q",
            "nl": "S1按下"
          }
        ],
        "formula": "p <-> q",
        "mode": "entails"
      }
    },
    {
      "id": "LR2",
      "group": "logical_relation",
      "desc": "形式化必须表示：L2灯亮当且仅当“S1未按下或S2按下”，并保留析取和双向条件。",
      "score": 0,
      "reason": "L2的条件直接影响L3是否亮，从而影响对S1是否可能或必然按下的判断。",
      "z3_check": {
        "atoms": [
          {
            "key": "p",
            "nl": "L2灯亮"
          },
          {
            "key": "q",
            "nl": "S1按下"
          },
          {
            "key": "r",
            "nl": "S2按下"
          }
        ],
        "formula": "p <-> (~q | r)",
        "mode": "entails"
      }
    },
    {
      "id": "LR3",
      "group": "logical_relation",
      "desc": "形式化必须表示：L3灯亮当且仅当“L1灯亮且L2灯不亮”，并保留合取、否定和双向条件。",
      "score": 0,
      "reason": "题目给出的最终观测是L3没有亮，因此L3与L1、L2的双向关系是约束S1状态的关键。",
      "z3_check": {
        "atoms": [
          {
            "key": "p",
            "nl": "L3灯亮"
          },
          {
            "key": "q",
            "nl": "L1灯亮"
          },
          {
            "key": "r",
            "nl": "L2灯亮"
          }
        ],
        "formula": "p <-> (q & ~r)",
        "mode": "entails"
      }
    },
    {
      "id": "SC1",
      "group": "stated_constraint",
      "desc": "形式化必须包含S1和S2不能同时按下这一电路短路约束。",
      "score": 0,
      "reason": "该约束排除了部分开关组合，是判断S1是否可能或必然按下时必须保留的显式限制。",
