          {
            "key": "q",
            "nl": "S2按下"
          }
        ],
        "formula": "~(p & q)",
        "mode": "entails"
      }
    },
    {
      "id": "SC2",
      "group": "stated_constraint",
      "desc": "形式化必须包含最终L3灯没有亮这一已知状态。",
