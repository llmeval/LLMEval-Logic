          {
            "key": "B",
            "nl": "B赞成代表的观点"
          }
        ],
        "formula": "A -> ~B",
        "mode": "entails"
      }
    },
    {
      "id": "LR2",
      "group": "logical_relation",
      "desc": "应正确表示“B 和 C 的态度相同”，即二者同赞成或同反对。",
      "score": 0,
      "reason": "B 与 C 的一致性直接限制了可枚举模型，不能误写成只允许某一方向或只允许同赞成。",
      "z3_check": {
