            "nl": "A赞成代表的观点"
          },
          {
            "key": "C",
            "nl": "C赞成代表的观点"
          }
        ],
        "formula": "~(A & C)",
        "mode": "entails"
      }
    },
    {
      "id": "LR4",
      "group": "logical_relation",
      "desc": "应正确表示“如果 C 赞成自己的路线，那么 A 一定也赞成自己的路线”这一单向条件关系。",
      "score": 0,
      "reason": "该蕴含关系规定了 C 赞成时对 A 态度的依赖，方向不能颠倒或弱化。",
