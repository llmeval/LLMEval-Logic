      "id": "LR1",
      "group": "logical_relation",
      "desc": "应正确表示“A 如果赞成，则 B 一定反对”这一单向条件关系。",
      "score": 0,
      "reason": "该条件关系限定了 A 的赞成会排除 B 的赞成，是求三人可能态度的核心约束。",
      "z3_check": {
        "atoms": [
          {
            "key": "A",
